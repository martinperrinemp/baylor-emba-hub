name = "baylor-emba-proposals"
main = "src/index.mjs"
compatibility_date = "2026-10-10"

# Replace ID after running: npx wrangler d1 create baylor-emba-proposals
[[d1_databases]]
binding = "DB"
database_name = "baylor-emba-proposals"
database_id = "REPLACE-WITH-ACTUAL-D1-ID"
migrations_dir = "migrations"

# Emergency pause switch: leave false until the first private backup
# and live smoke tests have succeeded. Changes require redeploy.
[vars]
INTAKE_ENABLED = "false"
