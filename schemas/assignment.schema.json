{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared assignment metadata",
  "type": "object",
  "required": [
    "id",
    "course_id",
    "title",
    "verification_status",
    "source_type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "course_id": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "presentation_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "submission_due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "official_due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "verification_status": {
      "enum": [
        "verified",
        "needs_verification",
        "conflicted"
      ]
    },
    "source_type": {
      "enum": [
        "syllabus",
        "instructor",
        "canvas_manually_checked",
        "other"
      ]
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}
